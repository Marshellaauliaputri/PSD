import io, zipfile

UKURAN_RESIZE = (256, 256)          # semua gambar disamakan ukurannya
EKSTENSI = (".jpg", ".jpeg", ".png", ".bmp", ".webp", ".jfif")

# Parameter GLCM: jarak d = 1, sudut θ = 0° (tetangga kanan), 256 level keabuan
GLCM_DX, GLCM_DY, GLCM_LEVEL = 1, 0, 256

FOLDER_OUTPUT = "data/processed"    # tempat CSV hasil (dibuat otomatis)
os.makedirs(FOLDER_OUTPUT, exist_ok=True)

def pilih_file():
    """Tampilkan dialog pilih file. Kembalikan dict {nama_file: isi_bytes}."""
    try:
        from google.colab import files               # Google Colab
        return dict(files.upload())
    except ImportError:                              # Jupyter / VS Code lokal
        import tkinter as tk
        from tkinter import filedialog
        root = tk.Tk(); root.withdraw(); root.attributes("-topmost", True)
        paths = filedialog.askopenfilenames(title="Pilih zip / gambar dataset")
        root.destroy()
        hasil = {}
        for pth in paths:
            with open(pth, "rb") as fh:
                hasil[os.path.basename(pth)] = fh.read()
        return hasil

berkas = pilih_file()
if not berkas:
