import pandas as pd
from google.colab import files

# Upload data
print("Upload file NO2:")
uploaded_no2 = files.upload()
df_no2 = pd.read_csv(list(uploaded_no2.keys())[0])

print("Upload file CO:")
uploaded_co = files.upload()
df_co = pd.read_csv(list(uploaded_co.keys())[0])

print("Upload file SO2:")
uploaded_so2 = files.upload()
df_so2 = pd.read_csv(list(uploaded_so2.keys())[0])

# Konversi tanggal
df_no2["date"] = pd.to_datetime(df_no2["date"])
df_co["date"] = pd.to_datetime(df_co["date"])
df_so2["date"] = pd.to_datetime(df_so2["date"])

# Urutkan tanggal
df_no2 = df_no2.sort_values("date")
df_co = df_co.sort_values("date")
df_so2 = df_so2.sort_values("date")

# Rentang 366 hari
tanggal = pd.date_range(
    start="2025-08-31",
    end="2026-08-31",
    freq="D"
)

# Lengkapi tanggal
df_no2 = df_no2.set_index("date").reindex(tanggal)
df_co = df_co.set_index("date").reindex(tanggal)
df_so2 = df_so2.set_index("date").reindex(tanggal)

# Gabungkan 3 polutan
data_366 = pd.DataFrame({
    "date": tanggal,
    "CO": df_co["CO"].values,
    "NO2": df_no2["NO2"].values,
    "SO2": df_so2["SO2"].values
})

# Cek hasil
print("Jumlah hari:", len(data_366))

print("\nJumlah data yang tersedia:")
print(data_366.notna().sum())

print("\nJumlah missing value:")
print(data_366.isna().sum())

display(data_366.head())
display(data_366.tail())

# Simpan
nama_file = "Data_Polutan_Kalianget_366.csv"

data_366.to_csv(
    nama_file,
    index=False
)

files.download(nama_file)
